<style>
    .card-img, .card-img-bottom, .card-img-top {
        width: 100%;
        height: 230px;
        object-fit: cover;
    }

    .banner img {
        width: 100%;
    }

    .peyment-img img {
        width: 45px;
    }

    .modal-footer {
        border-top: none !important;
    }

    .modal-header {
        border-bottom: none;
    }
    /* .peyment-img {
        border: 1px solid;
        width: 110px;
        border-radius: 5px;
        height: 55px;
    } */
    .payment-design img {
        width: 110px;
        height: 110px;
        object-fit: cover;
    }

    .modal-body {
        border: 1px solid #dee2e6;
        margin: 0px 13px;
        border-radius: 7px;
        cursor: pointer;
    }

        .modal-body:hover {
            border: 1px solid #000;
        }

    .payment-area {
    }
</style>
