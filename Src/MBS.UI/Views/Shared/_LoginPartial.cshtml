@using MBS.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager


@if (SignInManager.IsSignedIn(User))
{
    bool isSuperAdmin = User.IsInRole("Super Admin");
    bool isAdmin = User.IsInRole("Admin");
    bool isSimpleUser = User.IsInRole("SimpleUser");
    bool isServiceProvider = User.IsInRole("ServiceProvider");
    bool isRetailer = User.IsInRole("Retailer");
    bool isSupplier = User.IsInRole("Supplier");

    <div class="dropdown">
        <button style="background:#318781" class="btn  dropdown-toggle text-warning" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
            @User.Identity?.Name!
        </button>
        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
            
            <li class="nav-item">
                <a class="dropdown-item text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">View Profile</a>
            </li>
            @if (isSuperAdmin == true)
            {
                <li class="nav-item">
                    <a id="manage" class="dropdown-item text-dark" asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboared</a>
                </li>
            }
            @if (isSimpleUser == true)
            {
                <li class="nav-item">
                    <a id="manage" class="dropdown-item text-dark" asp-area="ShopUser" asp-controller="Home" asp-action="Index">Dashboared</a>
                </li>
            }
            @if (isServiceProvider == true)
            {
                <li class="nav-item">
                    <a id="manage" class="dropdown-item text-dark" asp-area="ServiceProvider" asp-controller="Home" asp-action="Index">Dashboared</a>
                </li>
            }
            @if (isSimpleUser == true)
            {
              
            }
            <li class="nav-item">
                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button type="submit" class="dropdown-item btn btn-link text-danger">Logout</button>
                </form>
            </li>
        </ul>
    </div>
   
}
else
{
   
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}

